# Template only. Replace placeholders in your environment; do not commit a real .env.
POSTGRES_DB=pkb
POSTGRES_USER=pkb_owner
POSTGRES_PASSWORD=replace_with_random_migration_password
APP_DB_PASSWORD=replace_with_random_runtime_password
CONNECTOR_DB_PASSWORD=replace_with_random_connector_password
REDIS_PASSWORD=replace_with_random_redis_password
API_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
# JSON array of authenticated WeCom external_userid values. Empty denies everyone.
WECOM_ALLOWED_USER_IDS=[]
# M2 is opt-in. Use an enterprise application authorized for WeChat Customer Service.
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_OPEN_KFIDS=[]
WECOM_AUTO_REPLY=true
# Default reply applies when ingestion / knowledge Q&A are disabled.
# WECOM_REPLY_TEXT=收到，微信客服连接已就绪。资料整理和知识库问答功能尚未启用。
# WECOM_CALLBACK_BUDGET_SECONDS=3
# WECOM_MAX_CALLBACK_BYTES=65536
# WECOM_HTTP_TIMEOUT_SECONDS=8
# WECOM_POLL_INTERVAL_SECONDS=60
# WECOM_RETRY_BASE_SECONDS=5
# WECOM_MAX_ATTEMPTS=5
# WECOM_MAX_PAGES_PER_SYNC=100
# M3 is opt-in. Provision a private S3-compatible bucket before enabling.
INGESTION_ENABLED=false
# INGESTION_MAX_FILE_BYTES=20971520
# INGESTION_MAX_TEXT_BYTES=2097152
# INGESTION_MAX_URLS=10
# INGESTION_JOB_TIMEOUT_SECONDS=90
# INGESTION_LEASE_SECONDS=120
# INGESTION_MAX_ATTEMPTS=3
# Bounded document/OCR/web parsing; knowledge indexing is enabled separately below.
PARSING_ENABLED=false
# PARSER_TIMEOUT_SECONDS=45
# PARSER_MAX_TEXT_CHARS=500000
# PARSER_MAX_PAGES=100
# PARSER_MAX_CELLS=50000
# OCR_LANGUAGES=chi_sim+eng
# Compose supplies ws://browser:3000/ on its internal browser network.
# BROWSER_WS_URL must refer to the isolated browser service for local worker runs.
# M5 opt-in. Set task timeout/lease to at least 270/285 seconds (recommended 300/330).
MEDIA_PARSING_ENABLED=false
# INGESTION_JOB_TIMEOUT_SECONDS=300
# INGESTION_LEASE_SECONDS=330
# MEDIA_TIMEOUT_SECONDS=240
# MEDIA_MAX_DURATION_SECONDS=900
# MEDIA_CHUNK_SECONDS=300
# MEDIA_MAX_FRAMES=12
# MEDIA_FRAME_INTERVAL_SECONDS=30
# MEDIA_SCENE_THRESHOLD=0.3
# Only ingestion-worker and agent-worker receive this credential. Transcription is fixed to whisper-1
# for segment timestamps. Set a vision-capable Responses model available to your project.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
# M6 opt-in: indexes normalized Markdown; M7 chat/Agent is not enabled by this flag.
KNOWLEDGE_ENABLED=false
# KNOWLEDGE_HTTP_TIMEOUT_SECONDS=20
# KNOWLEDGE_MAX_DOCUMENT_BYTES=8388608
# KNOWLEDGE_POLL_SECONDS=10
# KNOWLEDGE_INDEX_TIMEOUT_SECONDS=3600
# M7 opt-in. Start both ingestion and agent profiles; pick an explicit Responses
# model supporting function tools and structured outputs in your OpenAI project.
AGENT_ENABLED=false
OPENAI_AGENT_MODEL=
# AGENT_HTTP_TIMEOUT_SECONDS=30
# AGENT_JOB_TIMEOUT_SECONDS=120
# AGENT_LEASE_SECONDS=150
# AGENT_MAX_ATTEMPTS=3
# AGENT_MAX_TURNS=6
# AGENT_MAX_OUTPUT_TOKENS=2000
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1
# For a local Python process (Compose builds these URLs internally):
# DATABASE_URL=postgresql+asyncpg://pkb_app:<URL-encoded-password>@localhost:5432/pkb
# DATABASE_ADMIN_URL=postgresql+asyncpg://pkb_owner:<URL-encoded-password>@localhost:5432/pkb
# CONNECTOR_DATABASE_URL=postgresql+asyncpg://pkb_connector:<URL-encoded-password>@localhost:5432/pkb
# REDIS_URL=redis://:<URL-encoded-password>@localhost:6379/0
# Use URL-safe random passwords in Compose, e.g. secrets.token_hex(32).
# Optional Docker Official Images mirror if Docker Hub is unreachable:
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim-bookworm
# POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-bookworm
# REDIS_IMAGE=public.ecr.aws/docker/library/redis:7.4-bookworm
# Optional compose.production.yml HTTPS edge; files must be readable by UID 10001.
# PKB_TLS_DIR=/absolute/private/tls
# PKB_HTTPS_BIND=0.0.0.0
# PKB_HTTPS_PORT=443
# NGINX_IMAGE=nginx:stable-bookworm
